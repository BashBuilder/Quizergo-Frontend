{
  "$schema": "https://opencode.ai/config.json",
  "instructions": "agent.md",
  "mcp": {
    "graphify": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "graphify.mcp"
      ],
      "env": {
        "PYTHONPATH": ".",
        "GRAPHIFY_PATH": "C:\\Users\\Delice\\Desktop\\dev\\Quizergo-Frontend\\graphify-out"
      }
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "**/node_modules/**",
      ".next/**",
      "**/.next/**",
      "out/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/playwright-report/**",
      "**/test-results/**",
      ".vercel/**",
      ".git/**"
    ]
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*node_modules/*": "deny",
      "*.next/*": "deny",
      "out/*": "deny",
      "*dist/*": "deny",
      "*build/*": "deny",
      "*coverage/*": "deny",
      "*playwright-report/*": "deny",
      "*test-results/*": "deny",
      "*.tsbuildinfo": "deny",
      "*pnpm-lock.yaml": "deny",
      "*package-lock.json": "deny",
      "*.stackdump": "deny",
      "*.png": "deny",
      "*.jpg": "deny",
      "*.jpeg": "deny",
      "*.webp": "deny",
      "*.ico": "deny",
      "*.mp4": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*pnpm-lock.yaml": "deny",
      "*package-lock.json": "deny",
      ".next/*": "deny",
      "next-env.d.ts": "deny"
    },
    "bash": {
      "*": "allow",
      "*node_modules*": "deny",
      "*pnpm-lock.yaml*": "deny"
    }
  }
}