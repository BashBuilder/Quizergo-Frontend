{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "agent.md"],
  "mcp": {
    "21st": {
      "type": "remote",
      "url": "https://21st.dev/api/mcp",
      "headers": { "x-api-key": "{env:API_KEY_21ST}" },
      "enabled": true
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "**/node_modules/**",
      ".next/**",
      "**/.next/**",
      "out/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/playwright-report/**",
      "**/test-results/**",
      ".vercel/**",
      ".git/**"
    ]
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*node_modules/*": "deny",
      "*.next/*": "deny",
      "out/*": "deny",
      "*dist/*": "deny",
      "*build/*": "deny",
      "*coverage/*": "deny",
      "*playwright-report/*": "deny",
      "*test-results/*": "deny",
      "*.tsbuildinfo": "deny",
      "*pnpm-lock.yaml": "deny",
      "*package-lock.json": "deny",
      "*.stackdump": "deny",
      "*.png": "deny",
      "*.jpg": "deny",
      "*.jpeg": "deny",
      "*.webp": "deny",
      "*.ico": "deny",
      "*.mp4": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*pnpm-lock.yaml": "deny",
      "*package-lock.json": "deny",
      ".next/*": "deny",
      "next-env.d.ts": "deny"
    },
    "bash": {
      "*": "allow",
      "*node_modules*": "deny",
      "*pnpm-lock.yaml*": "deny"
    }
  }
}
